{
  "name": "english-janala",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "English Janala — an adaptive, offline-first English learning studio for Bangla speakers, written in strict TypeScript.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.2",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
